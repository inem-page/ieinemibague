# Copia este archivo como .env.local y completa tus valores reales.
# .env.local NO se sube a git (ya está en .gitignore).

# API key de https://resend.com (necesaria para que el formulario de
# contacto envíe correos reales).
RESEND_API_KEY=

# Correo institucional que recibirá los mensajes del formulario.
CONTACT_TO_EMAIL=ieinemibague@hotmail.com

# Remitente verificado en Resend. Mientras no verifiques un dominio propio,
# puedes dejar el remitente de pruebas de Resend:
CONTACT_FROM_EMAIL=onboarding@resend.dev
